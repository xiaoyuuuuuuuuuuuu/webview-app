{
  "name": "webview-app",
  "version": "1.0.0",
  "description": "Capacitor webview shell for a website (Android + iOS)",
  "scripts": {
    "configure": "node scripts/configure.mjs",
    "sync": "npm run configure && npx cap sync && node scripts/verify.mjs",
    "sync:android": "npm run configure && npx cap sync android",
    "sync:ios": "npm run configure && npx cap sync ios",
    "build:android": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "build:android:release": "npm run sync:android && cd android && ./gradlew bundleRelease",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "doctor": "npx cap doctor",
    "assets": "npx capacitor-assets generate --android --ios",
    "assets:placeholder": "python3 scripts/make-placeholder-assets.py && npm run assets",
    "verify": "node scripts/verify.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/media": "^9.1.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
