<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 深度链接(iOS Universal Links)。applinks: 后面的 host 由
	     scripts/configure.mjs 从 app.config.json 的 siteUrl 同步,别手改。

	     注意:带这个 entitlement 的签名构建要求 Apple 开发者后台的 App ID 上
	     打开 Associated Domains 能力,否则 provisioning profile 对不上、签名会失败。
	     无证书的编译验证不受影响。 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:shop.example.com</string>
	</array>
</dict>
</plist>
